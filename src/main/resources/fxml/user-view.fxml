<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.recuperacion.carmanager.controller.UserController"
            styleClass="content-view">

    <top>
        <VBox spacing="12" styleClass="content-header">
            <padding>
                <Insets top="18" right="24" bottom="14" left="24"/>
            </padding>

            <Label text="Gestión de usuarios" styleClass="section-title-label"/>
            <Label text="Panel de administración para consultar usuarios, filtrar por email y modificar roles"
                   styleClass="section-subtitle-label"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="emailFilterField"
                           promptText="Filtrar por email"
                           prefWidth="260"
                           styleClass="form-field"/>

                <Button text="Filtrar"
                        onAction="#handleFilterUsers"
                        styleClass="primary-button"/>

                <Button text="Limpiar"
                        onAction="#handleClearFilter"
                        styleClass="secondary-button"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT"
                  styleClass="users-actions-box">

                <Label text="Rol del usuario seleccionado:"
                       styleClass="users-action-label"/>

                <ComboBox fx:id="roleComboBox"
                          promptText="Selecciona rol"
                          prefWidth="160"
                          styleClass="form-field"/>

                <Button text="Cambiar rol"
                        onAction="#handleChangeRole"
                        styleClass="primary-button"/>

                <Button text="Eliminar usuario"
                        onAction="#handleDeleteUser"
                        styleClass="danger-button"/>
            </HBox>

            <Label fx:id="messageLabel" styleClass="info-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="users-table-container">
            <padding>
                <Insets top="20" right="24" bottom="24" left="24"/>
            </padding>

            <TableView fx:id="usersTableView"
                       VBox.vgrow="ALWAYS"
                       styleClass="users-table">

                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="usernameColumn"
                                 text="Username"
                                 prefWidth="180"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="280"/>

                    <TableColumn fx:id="roleColumn"
                                 text="Rol"
                                 prefWidth="120"/>
                </columns>

            </TableView>
        </VBox>
    </center>

</BorderPane>