<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="detailRoot"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.recuperacion.carmanager.controller.CarDetailsController"
            styleClass="car-detail-root">

    <center>
        <StackPane fx:id="imageContainer"
                   styleClass="car-detail-image-panel">

            <ImageView fx:id="carImageView"
                       preserveRatio="true"
                       smooth="true"/>

            <Label fx:id="imagePlaceholderLabel"
                   text="Imagen no disponible"
                   visible="false"
                   styleClass="car-detail-placeholder-label"/>
        </StackPane>
    </center>

    <right>
        <VBox spacing="16"
              prefWidth="390"
              styleClass="car-detail-sidebar">

            <padding>
                <Insets top="28" right="24" bottom="28" left="24"/>
            </padding>

            <Label fx:id="carNameLabel"
                   text="Nombre del coche"
                   wrapText="true"
                   styleClass="car-detail-title"/>

            <VBox spacing="8" styleClass="car-detail-section">
                <Label text="Detalles del coche" styleClass="car-detail-section-title"/>
                <Label fx:id="typeLabel" styleClass="car-detail-text"/>
                <Label fx:id="powerLabel" styleClass="car-detail-text"/>
                <Label fx:id="registrationDateLabel" styleClass="car-detail-text"/>
                <Label fx:id="imagePathLabel" wrapText="true" styleClass="car-detail-muted-text"/>
            </VBox>

            <VBox spacing="8" styleClass="car-detail-section">
                <Label text="Clasificación" styleClass="car-detail-section-title"/>
                <Label fx:id="votesLabel" styleClass="car-detail-text"/>
                <Label fx:id="rankingLabel" styleClass="car-detail-text"/>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="car-detail-section">
                <Label text="Usuarios que lo tienen como favorito"
                       wrapText="true"
                       styleClass="car-detail-section-title"/>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="detail-users-scroll-pane">
                    <content>
                        <VBox fx:id="favoriteUsersBox"
                              spacing="8"
                              styleClass="detail-users-box"/>
                    </content>
                </ScrollPane>
            </VBox>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   styleClass="info-label"/>

            <Button text="Volver a coches"
                    onAction="#handleBackToCars"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>
        </VBox>
    </right>

</BorderPane>