<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.recuperacion.carmanager.controller.RegisterController"
      alignment="CENTER"
      spacing="14"
      styleClass="root-container">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Registro de usuario" styleClass="title-label"/>
    <Label text="Crea una cuenta para acceder a la aplicación" styleClass="subtitle-label"/>

    <TextField fx:id="usernameField"
               promptText="Nombre de usuario"
               maxWidth="280"
               styleClass="form-field"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="280"
               styleClass="form-field"/>

    <PasswordField fx:id="passwordField"
                   promptText="Contraseña"
                   maxWidth="280"
                   styleClass="form-field"/>

    <PasswordField fx:id="checkPasswordField"
                   promptText="Repetir contraseña"
                   maxWidth="280"
                   styleClass="form-field"/>

    <Label fx:id="messageLabel" styleClass="error-label"/>

    <Button text="Registrar usuario"
            onAction="#handleRegister"
            maxWidth="280"
            styleClass="primary-button"/>

    <Button text="Volver al login"
            onAction="#handleBackToLogin"
            maxWidth="280"
            styleClass="secondary-button"/>

</VBox>